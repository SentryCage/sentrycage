# Demo needs no .env. Configure these only for live monitoring.
ENABLED_CHAINS=ethereum
ETHERSCAN_API_KEY=
ETHEREUM_RPC_URL=
# Required only if arbitrum is in ENABLED_CHAINS.
ARBITRUM_RPC_URL=

# Explicitly set false to save signals locally without notifications.
NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --test and --preview send real messages to this ID, or TELEGRAM_CHAT_ID.
TEST_CHAT_ID=

DB_PATH=./data/whale_tracker.db
POLLING_INTERVAL=60
TRANSACTION_THRESHOLD=100
REQUEST_TIMEOUT=10
EXPLORER_PAGE_SIZE=100
EXPLORER_MAX_PAGES=1000

ENABLE_REASONING=false
LLM_PROVIDER=ollama
MAX_REASONING_ITERATIONS=5
REASONING_TIMEOUT=30
# For Compose's AI profile use http://ollama:11434.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
